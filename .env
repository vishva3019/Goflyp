# =======================================================
# GOFLYP ENVIRONMENT CONFIGURATION
# =======================================================

# Server Configuration
PORT=5050
NODE_ENV=development

# Authentication & Security
# Replace with a cryptographically secure 64-character secret in production
JWT_SECRET=goflyp_jwt_secret_alliance_university_campus_ride_split_2026_super_secure

# Database Configuration (Native SQLite storage path)
DATABASE_PATH=./data/goflyp.db

# Alliance University Campus Geospatial Anchors
ALLIANCE_CAMPUS_NAME=Alliance University Main Entrance Gate
ALLIANCE_CAMPUS_LAT=12.7298
ALLIANCE_CAMPUS_LNG=77.7088
ALLIANCE_EMAIL_DOMAIN=alliance.edu.in
EXPO_PUBLIC_ALLIANCE_EMAIL_DOMAIN=alliance.edu.in

# Geospatial Routing Engine (OpenStreetMap OSRM road-following network)
# Default uses public OSRM car routing engine; replace with self-hosted OSRM or Google/Mapbox Directions API in enterprise production.
OSRM_ROUTING_URL=https://router.project-osrm.org

# Optional Commercial Map Provider Keys (Configure when building native iOS release)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Mobile Frontend API Gateway endpoint
EXPO_PUBLIC_API_URL=https://3bf3-2409-40f2-2047-4ce3-24dd-8e3d-347-cc93.ngrok-free.app/api
